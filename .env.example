# ============================================================
#  WASITO / NEO WAS — Variables de entorno (plantilla)
#  Copia este archivo a ".env.local" y rellena los valores.
# ============================================================

# --- Autenticación del panel Wasito ---
# Genera el hash con: node -e "console.log(require('crypto').createHash('sha256').update('wasito_salt_'+'TU_PASSWORD').digest('hex'))"
AUTH_TOKEN_SECRET=cambia-esta-clave-secreta-larga
ADMIN_USER=rodorl3
ADMIN_PASS_HASH=
SECOND_USER=Wasito26
SECOND_PASS_HASH=

# --- Cerebro (LLM) — DeepSeek (modelo principal para todo) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Voz / transcripción de audio — OpenAI ---
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-transcribe

# --- URL del formulario de recabación (sección Enlaces) ---
FORM_URL=

# --- URL pública (deploy) ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
